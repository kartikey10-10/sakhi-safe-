#!/usr/bin/env sh
set -eu
VERSION=8.13
BASE="${GRADLE_USER_HOME:-$HOME/.gradle}/sakhi-wrapper"
BIN="$BASE/gradle-$VERSION/bin/gradle"
if [ ! -x "$BIN" ]; then
  mkdir -p "$BASE"
  TMP="$BASE/gradle-$VERSION.zip"
  curl -fsSL "https://services.gradle.org/distributions/gradle-$VERSION-bin.zip" -o "$TMP"
  unzip -oq "$TMP" -d "$BASE"
  rm -f "$TMP"
fi
exec "$BIN" "$@"
